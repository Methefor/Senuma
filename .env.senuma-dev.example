# Copy to .env.senuma-dev.local (git-ignored) and fill in from the Senuma DEVELOPMENT project.
# None of these is a secret: they identify the project and the OAuth client, and ship inside the
# extension. They are kept out of git only so that no build accidentally points at a project.
VITE_SENUMA_SYNC=firebase
VITE_FIREBASE_PROJECT=
VITE_FIREBASE_API_KEY=
VITE_GOOGLE_CLIENT_ID=
# The store item's public key (from its manifest), so that the development build has the store
# item's extension ID and Google's redirect address https://<id>.chromiumapp.org/ matches.
SENUMA_EXTENSION_KEY=
