{
  "name": "senuma",
  "private": true,
  "version": "2.1.0-dev.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:sync": "cross-env VITE_SENUMA_SYNC=emulator vite build",
    "build:sync:firebase": "vite build --mode senuma-dev",
    "build:e2e": "cross-env BOS_E2E=1 vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e scripts firebase vite.config.ts",
    "emulator": "firebase emulators:start --only firestore --project demo-senuma --config firebase/firebase.json",
    "test:rules:mutations": "node scripts/rules-mutations.mjs",
    "test:sync:e2e": "npm run build:sync && firebase emulators:exec --only firestore --project demo-senuma --config firebase/firebase.json \"vite-node e2e/sync.e2e.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-senuma --config firebase/firebase.json \"vitest run --config firebase/vitest.config.ts\"",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:e2e && vite-node e2e/extension.e2e.ts",
    "test:rc": "npm run build && vite-node e2e/rc.e2e.ts",
    "rehearse": "npm run build && vite-node e2e/rehearsal.ts",
    "headed": "npm run build && vite-node e2e/headed.ts",
    "package": "npm run build && node scripts/package-rc.mjs",
    "headed:update": "npm run build && vite-node e2e/headed-update.ts",
    "store:assets": "npm run build && vite-node e2e/store-assets.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run size",
    "visual": "npm run build && vite-node e2e/visual.ts",
    "size": "node scripts/size.mjs",
    "marks": "node scripts/brand-marks.mjs",
    "icons": "node scripts/brand-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "playwright": "^1.63.0",
    "simple-icons": "^16.33.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
