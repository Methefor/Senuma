{
  "name": "browser-os",
  "private": true,
  "version": "2.0.0-alpha.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "cross-env BOS_E2E=1 vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e vite.config.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:e2e && vite-node e2e/extension.e2e.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "visual": "npm run build && vite-node e2e/visual.ts"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
