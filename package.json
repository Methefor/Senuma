{
  "name": "senuma",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "cross-env BOS_E2E=1 vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e scripts vite.config.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:e2e && vite-node e2e/extension.e2e.ts",
    "test:rc": "npm run build && vite-node e2e/rc.e2e.ts",
    "test:help": "npm run build && vite-node e2e/help-feedback.ts",
    "rehearse": "npm run build && vite-node e2e/rehearsal.ts",
    "headed": "npm run build && vite-node e2e/headed.ts",
    "package": "npm run build && node scripts/package-rc.mjs",
    "headed:update": "npm run build && vite-node e2e/headed-update.ts",
    "store:assets": "npm run build && vite-node e2e/store-assets.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run size",
    "visual": "npm run build && vite-node e2e/visual.ts",
    "size": "node scripts/size.mjs",
    "marks": "node scripts/brand-marks.mjs",
    "icons": "node scripts/brand-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "simple-icons": "^16.33.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
